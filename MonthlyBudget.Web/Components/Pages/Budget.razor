@page "/wydatki"
@rendermode InteractiveServer
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Threading

<PageTitle>Lista wydatk&#243;w</PageTitle>

<div class="budget-page">
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="status-overlay">
            <div class="status-popup @(isStatusError ? "status-popup-error" : "status-popup-success")">
                @statusMessage
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(lastExpenseClickMessage) || !string.IsNullOrWhiteSpace(expenseAddedMessage))
    {
        <div class="budget-toast-stack" aria-live="polite" aria-atomic="true">
            @if (!string.IsNullOrWhiteSpace(lastExpenseClickMessage))
            {
                <div class="budget-status budget-status-toast">@lastExpenseClickMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(expenseAddedMessage))
            {
                <div class="budget-status budget-status-toast">@expenseAddedMessage</div>
            }
        </div>
    }

    @if (currentBudget is not null)
    {
        <section class="budget-card budget-card-main">
            <form class="mb-3">
                <div class="d-flex align-items-center gap-2 flex-nowrap budget-filters-row">
                    <div class="position-relative budget-filter-search">
                        <span class="search-icon" aria-hidden="true">&#128269;</span>
                        <input type="text"
                               class="form-control border border-secondary rounded search-input"
                               placeholder="Szukaj..."
                               @bind="searchTerm"
                               @bind:event="oninput"
                               @bind:after="ScheduleFiltersAsync" />
                    </div>

                    <div class="position-relative d-inline-flex align-items-center justify-content-center">
                        <button id="okresBtn" type="button"
                                class="@DateFilterButtonClass"
                                @onclick="ToggleDateFilterAsync">
                            @DateFilterLabel
                        </button>

                        @if (showDateFilter)
                        {
                            <div id="okresPanel" class="budget-filter-panel budget-filter-panel-visible filter-panel">
                                <div class="budget-filter-panel-content d-flex align-items-center gap-2">
                                    <input type="date"
                                           class="form-control form-control-sm budget-filter-date"
                                           onclick="this.showPicker ? this.showPicker() : this.focus()"
                                           @bind="fromDateFilter"
                                           @bind:event="onchange"
                                           @bind:format="yyyy-MM-dd"
                                           @bind:after="ScheduleFiltersAsync" />

                                    <input type="date"
                                           class="form-control form-control-sm budget-filter-date"
                                           onclick="this.showPicker ? this.showPicker() : this.focus()"
                                           @bind="toDateFilter"
                                           @bind:event="onchange"
                                           @bind:format="yyyy-MM-dd"
                                           @bind:after="ScheduleFiltersAsync" />
                                </div>
                            </div>
                        }
                    </div>

                    <div class="position-relative d-inline-flex align-items-center justify-content-center">
                        <button id="kwotaBtn" type="button"
                                class="@AmountFilterButtonClass"
                                @onclick="ToggleAmountFilterAsync">
                            @AmountFilterLabel
                        </button>

                        @if (showAmountFilter)
                        {
                            <div id="kwotaPanel" class="budget-filter-panel budget-filter-panel-visible filter-panel">
                                <div class="budget-filter-panel-content d-flex gap-2 justify-content-center">
                                    <input type="number"
                                           class="form-control border border-secondary rounded budget-filter-amount"
                                           style="width: 160px; font-size: 0.9rem; text-align: right;"
                                           placeholder="0.00"
                                           min="0.01"
                                           max="999999999"
                                           step="0.01"
                                           @bind="minAmountFilter"
                                           @bind:event="oninput"
                                           @bind:after="ScheduleFiltersAsync" />

                                    <input type="number"
                                           class="form-control border border-secondary rounded budget-filter-amount"
                                           style="width: 160px; font-size: 0.9rem; text-align: right;"
                                           placeholder="0.00"
                                           min="0.01"
                                           max="999999999"
                                           step="0.01"
                                           @bind="maxAmountFilter"
                                           @bind:event="oninput"
                                           @bind:after="ScheduleFiltersAsync" />
                                </div>
                            </div>
                        }
                    </div>

                    <div class="position-relative d-inline-flex align-items-center justify-content-center budget-filter-category-picker" @key="CategoryFilterRenderKey">
                        <button type="button"
                                class="@CategoryFilterButtonClass"
                                style="width: 260px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; display: flex; align-items: center; justify-content: space-between;"
                                aria-expanded="@isDropdownOpen"
                                @onclick="ToggleDropdown">
                            <div class="position-relative w-100">
                                <span class="text-truncate flex-grow-1 pe-4">@CategoryDropdownText</span>

                                @if (selectedCategoryIds.Any())
                                {
                                    <button type="button"
                                            class="btn budget-filter-clear-button position-absolute top-50 end-0 translate-middle-y me-2"
                                            style="width: 26px; height: 26px; padding: 0; font-size: 1.2rem; font-weight: bold; line-height: 1; border-radius: 50%;"
                                            @onclick="ClearCategories"
                                            @onclick:stopPropagation="true">
                                        &times;
                                    </button>
                                }
                            </div>
                        </button>

                        @if (isDropdownOpen)
                        {
                            <div class="budget-filter-panel budget-filter-panel-visible filter-panel budget-filter-category-panel">
                                <ul class="budget-filter-category-menu">
                                    @foreach (var category in categories.Where(cat => !IsSystemCategory(cat)))
                                    {
                                        <li>
                                            <button type="button"
                                                    class="@GetCategoryOptionClass(category.Id)"
                                                    title="@category.Name"
                                                    @onclick="() => ToggleCategoryAsync(category.Id)">
                                                <span class="category-name text-truncate">@category.Name</span>
                                                <span class="budget-filter-category-indicator" aria-hidden="true">
                                                    @(selectedCategoryIds.Contains(category.Id) ? "\u2713" : "+")
                                                </span>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    @if (IsAnyFilterActive())
                    {
                        <div class="ms-auto">
                            <button type="button" class="btn btn-outline-secondary btn-sm budget-filter-button" @onclick="ResetFilters">
                                Resetuj
                            </button>
                        </div>
                    }
                </div>

                @if (showDateFilter || showAmountFilter || isDropdownOpen)
                {
                    <div
                            class="budget-filter-overlay"
                            @onclick="CloseFilterPanels"
                            aria-label="Zamknij panel filtr&#243;w"></div>
                }

            </form>

            <div class="budget-card-main-content">
                <div class="table-header">
                    <span>Lista wydatk&#243;w: @currentBudget.Month</span>
                </div>

                <div class="budget-table-section">
                    <table class="table budget-table">
                        <colgroup>
                            <col class="budget-col-name" />
                            <col class="budget-col-date" />
                            <col class="budget-col-category" />
                            <col class="budget-col-amount" />
                            <col class="budget-col-actions" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>
                                    <button type="button" class="@GetSortButtonClass(BudgetSortColumn.Name)" @onclick="() => SetSortAsync(BudgetSortColumn.Name)">
                                        <span>Nazwa</span>
                                        <span class="budget-sort-indicator">@GetSortIndicator(BudgetSortColumn.Name)</span>
                                    </button>
                                </th>
                                <th>
                                    <button type="button" class="@GetSortButtonClass(BudgetSortColumn.Date)" @onclick="() => SetSortAsync(BudgetSortColumn.Date)">
                                        <span>Data</span>
                                        <span class="budget-sort-indicator">@GetSortIndicator(BudgetSortColumn.Date)</span>
                                    </button>
                                </th>
                                <th>
                                    <button type="button" class="@GetSortButtonClass(BudgetSortColumn.Category)" @onclick="() => SetSortAsync(BudgetSortColumn.Category)">
                                        <span>Kategoria</span>
                                        <span class="budget-sort-indicator">@GetSortIndicator(BudgetSortColumn.Category)</span>
                                    </button>
                                </th>
                                <th>
                                    <button type="button" class="@GetSortButtonClass(BudgetSortColumn.Amount)" @onclick="() => SetSortAsync(BudgetSortColumn.Amount)">
                                        <span>Kwota</span>
                                        <span class="budget-sort-indicator">@GetSortIndicator(BudgetSortColumn.Amount)</span>
                                    </button>
                                </th>
                                <th class="budget-table-actions-header">Akcje</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!SortedFilteredExpenses.Any())
                            {
                                <tr>
                                    <td colspan="5" class="empty-row">Brak wydatk&#243;w.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var expense in PagedExpenses)
                                {
                                    <tr class="budget-expense-row">
                                        @if (editingExpenseId == expense.Id)
                                        {
                                            <td class="budget-expense-cell">
                                                <input class="form-control form-control-sm expense-edit-control" type="text" @bind="editingName" />
                                            </td>
                                            <td class="budget-expense-cell">
                                                <input class="form-control form-control-sm expense-edit-control"
                                                       type="date"
                                                       @bind="editingCreatedAt"
                                                       @bind:format="yyyy-MM-dd" />
                                            </td>
                                            <td class="budget-expense-cell">
                                                <select @bind="editingCategoryId" class="form-control form-control-sm expense-edit-control">
                                                    @foreach (var cat in AvailableCategories)
                                                    {
                                                        <option value="@cat.Id">@cat.Name</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="budget-expense-cell">
                                                <div class="input-group expense-edit-group">
                                                    <input class="form-control form-control-sm expense-edit-control text-end"
                                                           type="number"
                                                           min="0.01"
                                                           max="999999999"
                                                           step="0.01"
                                                           @bind="editingAmount" />
                                                    <span class="input-group-text expense-edit-suffix">PLN</span>
                                                </div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="budget-expense-cell">@expense.Name</td>
                                            <td class="budget-expense-cell">@expense.CreatedAt.ToString("dd.MM.yyyy")</td>
                                            <td class="budget-expense-cell">
                                                @if (IsNoCategoryExpense(expense))
                                                {
                                                    <span class="badge budget-missing-category-badge"
                                                          title="Ostrzeżenie:&#10;Wydatki bez kategorii nie są uwzględniane w wykresach i zestawieniach.">
                                                        Brak kategorii !
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="category-text" title="@expense.CategoryName">
                                                        @expense.CategoryName
                                                    </span>
                                                }
                                            </td>
                                            <td class="budget-expense-cell">@FormatCurrency(expense.Amount)</td>
                                        }
                                        <td class="budget-expense-cell budget-expense-cell-actions">
                                            @if (editingExpenseId == expense.Id)
                                            {
                                                <button class="btn btn-success btn-sm" type="button" @onclick="() => SaveEdit(expense.Id)">Zapisz</button>
                                                <button class="btn btn-secondary btn-sm" type="button" @onclick="CancelEdit">Anuluj</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-primary btn-sm" type="button" @onclick="() => StartEdit(expense)">Edytuj</button>
                                                <button class="btn btn-danger btn-sm" type="button" @onclick="() => DeleteExpense(expense.Id)">Usu&#324;</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (ShouldShowPagination)
                {
                    <div class="budget-pagination">
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm budget-pagination-nav"
                                @onclick="GoToPreviousPage"
                                disabled="@(CurrentPage == 1)">
                            Poprzednia
                        </button>

                        <div class="budget-pagination-pages">
                            @foreach (var pageNumber in PageNumbers)
                            {
                                <button type="button"
                                        class="@GetPageButtonClass(pageNumber)"
                                        @onclick="() => GoToPage(pageNumber)">
                                    @pageNumber
                                </button>
                            }
                        </div>

                        <button type="button"
                                class="btn btn-outline-secondary btn-sm budget-pagination-nav"
                                @onclick="GoToNextPage"
                                disabled="@(CurrentPage == TotalPages)">
                            Następna
                        </button>
                    </div>
                }
            </div>

        </section>
    }

    <section class="budget-card budget-card-form">
        <form class="budget-expense-form">
            <div class="budget-expense-form-row">
                <div class="budget-expense-field budget-expense-field-name">
                    <label class="form-label" for="expense-name">Nazwa</label>
                    <input id="expense-name" class="form-control" @bind="name" />
                </div>

                <div class="budget-expense-field budget-expense-field-date">
                    <label class="form-label" for="expense-date">Data</label>
                    <input id="expense-date"
                           class="form-control"
                           type="date"
                           @bind="newExpenseCreatedAt"
                           @bind:format="yyyy-MM-dd" />
                </div>

                <div class="budget-expense-field budget-expense-field-category">
                    <label class="form-label" for="expense-category">Kategoria</label>
                    <select id="expense-category" @bind="newExpenseCategoryId" class="form-control">
                        @foreach (var cat in AvailableCategories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>

                <div class="budget-expense-field budget-expense-field-amount">
                    <label class="form-label" for="expense-amount">Kwota</label>
                    <div class="input-group budget-currency-group budget-expense-amount-group">
                        <input id="expense-amount"
                               class="form-control text-end amount-number-input"
                               type="number"
                               min="0.01"
                               max="999999999"
                               step="0.01"
                               @bind="amount" />
                        <span class="input-group-text">PLN</span>
                    </div>
                </div>

                <div class="budget-expense-action">
                    <button class="btn btn-success budget-expense-submit" type="button" @onclick="AddExpense" disabled="@(currentBudget is null)">Dodaj</button>
                </div>
            </div>
        </form>
    </section>
</div>

@code {
    private const decimal MinExpenseAmount = 0.01m;
    private const decimal MaxExpenseAmount = 999999999m;
    private const int FilterDebounceDelayMs = 300;
    private const int PageSize = 10;
    private const string BudgetViewStateStorageKey = "monthly-budget.budget-view-state";
    private static readonly JsonSerializerOptions BudgetViewStateJsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = true
    };
    private int currentBudgetId = 1;
    private int selectedYear = DateTime.Now.Year;
    private int selectedMonth = DateTime.Now.Month;
    private string name = string.Empty;
    private DateTime newExpenseCreatedAt = DateTime.Today;
    private decimal amount;
    private int newExpenseCategoryId;
    private string statusMessage = string.Empty;
    private bool isStatusError;
    private int statusMessageVersion;
    private string lastExpenseClickMessage = string.Empty;
    private string expenseAddedMessage = string.Empty;
    private string searchTerm = string.Empty;
    private DateTime? fromDateFilter;
    private DateTime? toDateFilter;
    private decimal? minAmountFilter;
    private decimal? maxAmountFilter;
    private bool showDateFilter;
    private bool showAmountFilter;
    private bool isDropdownOpen;
    private CancellationTokenSource? filterDebounceCts;
    private CancellationTokenSource? filterRequestCts;
    private bool isDisposed;
    private bool viewStateInitialized;
    private bool hasCompletedInitialRestore;
    private bool isRestoringViewState;
    private bool pendingViewStatePersistence;
    private bool shouldPersistRestoredViewState;
    private int filterRequestVersion;
    private int categoryFilterRenderVersion;
    private string lastAppliedFilterState = string.Empty;
    private string lastScheduledFilterState = string.Empty;
    private BudgetSortColumn currentSortColumn = BudgetSortColumn.Date;
    private SortDirection currentSortDirection = SortDirection.Descending;
    private int currentPage = 1;
    private List<int> selectedCategoryIds = new();
    private List<Category> categories = new();
    private int? editingExpenseId;
    private string editingName = string.Empty;
    private decimal editingAmount;
    private DateTime editingCreatedAt;
    private int editingCategoryId;
    private BudgetDetailsResponse? currentBudget;

    private IEnumerable<ExpenseDto> SortedFilteredExpenses =>
        ApplySorting(
            currentBudget?.Expenses
                .Where(expense => selectedCategoryIds.Count == 0 || selectedCategoryIds.Contains(expense.CategoryId))
                ?? Enumerable.Empty<ExpenseDto>());

    private IEnumerable<ExpenseDto> PagedExpenses =>
        SortedFilteredExpenses
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize);

    private IEnumerable<Category> AvailableCategories =>
        categories.Where(category => !IsSystemCategory(category));

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(SortedFilteredExpenses.Count() / (double)PageSize));

    private int CurrentPage => Math.Clamp(currentPage, 1, TotalPages);

    private bool ShouldShowPagination => SortedFilteredExpenses.Count() > PageSize;

    private IEnumerable<int> PageNumbers => Enumerable.Range(1, TotalPages);

    private bool HasDefaultSort =>
        currentSortColumn == BudgetSortColumn.Date && currentSortDirection == SortDirection.Descending;

    private string CategoryDropdownText
    {
        get
        {
            if (selectedCategoryIds.Count == 0)
            {
                return "Wszystkie";
            }

            if (selectedCategoryIds.Count == 1)
            {
                var selectedCategoryId = selectedCategoryIds[0];
                var categoryName = categories
                    .FirstOrDefault(category => category.Id == selectedCategoryId)
                    ?.Name;

                return string.IsNullOrWhiteSpace(categoryName)
                    ? "1 wybrana"
                    : categoryName;
            }

            return $"{selectedCategoryIds.Count} wybrane";
        }
    }

    private string DateFilterLabel =>
        fromDateFilter.HasValue || toDateFilter.HasValue
            ? $"{FormatDateFilterValue(fromDateFilter)} - {FormatDateFilterValue(toDateFilter)}"
            : "Okres";

    private string AmountFilterLabel =>
        minAmountFilter.HasValue || maxAmountFilter.HasValue
            ? $"{FormatAmountFilterValue(minAmountFilter)} - {FormatAmountFilterValue(maxAmountFilter)} PLN"
            : "Kwota";

    private string DateFilterButtonClass =>
        showDateFilter
            ? "btn btn-outline-primary btn-sm budget-filter-toggle budget-filter-toggle-active"
            : "btn btn-outline-secondary btn-sm budget-filter-toggle";

    private string AmountFilterButtonClass =>
        showAmountFilter
            ? "btn btn-outline-primary btn-sm budget-filter-toggle budget-filter-toggle-active"
            : "btn btn-outline-secondary btn-sm budget-filter-toggle";

    private string CategoryFilterButtonClass =>
        isDropdownOpen
            ? "btn btn-outline-primary btn-sm budget-filter-toggle budget-filter-toggle-active no-hover"
            : "btn btn-outline-secondary btn-sm budget-filter-toggle";

    private string CategoryFilterRenderKey =>
        $"{categoryFilterRenderVersion}:{string.Join(",", selectedCategoryIds.OrderBy(categoryId => categoryId))}:{isDropdownOpen}";

    private string GetCategoryOptionClass(int categoryId)
    {
        return selectedCategoryIds.Contains(categoryId)
            ? "budget-filter-category-option budget-filter-category-option-selected"
            : "budget-filter-category-option";
    }

    private static bool IsSystemCategory(Category category)
    {
        return category.Id == 0
            || string.Equals(category.Name, "Brak kategorii", StringComparison.CurrentCultureIgnoreCase);
    }

    private static bool IsNoCategoryExpense(ExpenseDto expense)
    {
        return expense.CategoryId == 0
            || string.IsNullOrWhiteSpace(expense.CategoryName)
            || string.Equals(expense.CategoryName, "Brak kategorii", StringComparison.CurrentCultureIgnoreCase);
    }

    private async Task SetSortAsync(BudgetSortColumn column)
    {
        if (currentSortColumn == column)
        {
            currentSortDirection = currentSortDirection == SortDirection.Ascending
                ? SortDirection.Descending
                : SortDirection.Ascending;
            currentPage = 1;
        }
        else
        {
            currentSortColumn = column;
            currentSortDirection = GetDefaultSortDirection(column);
            currentPage = 1;
        }

        await PersistViewStateAsync();
    }

    private IEnumerable<ExpenseDto> ApplySorting(IEnumerable<ExpenseDto> expenses)
    {
        var orderedExpenses = currentSortColumn switch
        {
            BudgetSortColumn.Name => currentSortDirection == SortDirection.Ascending
                ? expenses.OrderBy(expense => expense.Name, StringComparer.CurrentCultureIgnoreCase)
                : expenses.OrderByDescending(expense => expense.Name, StringComparer.CurrentCultureIgnoreCase),
            BudgetSortColumn.Category => currentSortDirection == SortDirection.Ascending
                ? expenses.OrderBy(expense => expense.CategoryName, StringComparer.CurrentCultureIgnoreCase)
                : expenses.OrderByDescending(expense => expense.CategoryName, StringComparer.CurrentCultureIgnoreCase),
            BudgetSortColumn.Amount => currentSortDirection == SortDirection.Ascending
                ? expenses.OrderBy(expense => expense.Amount)
                : expenses.OrderByDescending(expense => expense.Amount),
            _ => currentSortDirection == SortDirection.Ascending
                ? expenses.OrderBy(expense => expense.CreatedAt)
                : expenses.OrderByDescending(expense => expense.CreatedAt)
        };

        return orderedExpenses.ThenByDescending(expense => expense.Id);
    }

    private string GetSortButtonClass(BudgetSortColumn column)
    {
        return currentSortColumn == column
            ? "budget-sort-button budget-sort-button-active"
            : "budget-sort-button";
    }

    private string GetSortIndicator(BudgetSortColumn column)
    {
        if (currentSortColumn != column)
        {
            return string.Empty;
        }

        return currentSortDirection == SortDirection.Ascending ? "\u2191" : "\u2193";
    }

    private static SortDirection GetDefaultSortDirection(BudgetSortColumn column)
    {
        return column is BudgetSortColumn.Date or BudgetSortColumn.Amount
            ? SortDirection.Descending
            : SortDirection.Ascending;
    }

    private void GoToPreviousPage()
    {
        if (CurrentPage > 1)
        {
            currentPage = CurrentPage - 1;
        }
    }

    private void GoToNextPage()
    {
        if (CurrentPage < TotalPages)
        {
            currentPage = CurrentPage + 1;
        }
    }

    private void GoToPage(int pageNumber)
    {
        currentPage = Math.Clamp(pageNumber, 1, TotalPages);
    }

    private string GetPageButtonClass(int pageNumber)
    {
        return pageNumber == CurrentPage
            ? "budget-page-button budget-page-button-active"
            : "budget-page-button";
    }

    private void ResetToFirstPage()
    {
        currentPage = 1;
    }

    private void EnsureCurrentPageInRange()
    {
        currentPage = Math.Clamp(currentPage, 1, TotalPages);
    }

    private async Task PositionPanel(string buttonId, string panelId)
    {
        if (isDisposed)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("positionFilterPanel", buttonId, panelId);
        }
        catch (InvalidOperationException)
        {
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.Now;
        selectedYear = now.Year;
        selectedMonth = now.Month;

        await LoadCategories();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isDisposed)
        {
            return;
        }

        await EnsureInitialRestoreCompletedAsync();
    }

    private async Task EnsureInitialRestoreCompletedAsync()
    {
        if (isDisposed || hasCompletedInitialRestore || isRestoringViewState)
        {
            return;
        }

        isRestoringViewState = true;

        try
        {
            await RestoreViewStateAsync();
            await ApplyFiltersAsync(force: true);
            hasCompletedInitialRestore = true;
            viewStateInitialized = true;
        }
        catch (InvalidOperationException)
        {
            return;
        }
        catch (JSException)
        {
            return;
        }
        finally
        {
            isRestoringViewState = false;
        }

        if (shouldPersistRestoredViewState)
        {
            shouldPersistRestoredViewState = false;
            await PersistViewStateAsync();
        }

        if (pendingViewStatePersistence)
        {
            pendingViewStatePersistence = false;
            await PersistViewStateAsync();
        }

        await RequestRenderAsync();
    }

    private async Task LoadCategories()
    {
        categories = await Http.GetFromJsonAsync<List<Category>>("http://localhost:5226/api/Budget/categories") ?? new();

        if (newExpenseCategoryId == 0)
        {
            newExpenseCategoryId = categories.FirstOrDefault(category => !IsSystemCategory(category))?.Id ?? 0;
        }
    }

    private async Task AddExpense()
    {
        ClearStatusMessage();
        lastExpenseClickMessage = $"Klik wykryty: {DateTime.Now:HH:mm:ss}";

        try
        {
            var budgetId = currentBudgetId;

            if (budgetId == 0)
            {
                await ShowStatusMessageAsync("Najpierw dodaj bud\u017cet.", true);
                return;
            }

            if (!await ValidateExpenseAmount(amount))
            {
                return;
            }

            var expense = new AddExpenseRequest
            {
                Name = name,
                Amount = amount,
                CreatedAt = newExpenseCreatedAt,
                CategoryId = newExpenseCategoryId == 0 ? 0 : newExpenseCategoryId
            };

            var response = await Http.PostAsJsonAsync($"http://localhost:5226/api/budget/{budgetId}/expense", expense);

            if (!response.IsSuccessStatusCode)
            {
                await ShowStatusMessageAsync("Nie uda\u0142o si\u0119 doda\u0107 wydatku.", true);
                return;
            }

            name = string.Empty;
            newExpenseCreatedAt = DateTime.Today;
            amount = 0;
            newExpenseCategoryId = categories.FirstOrDefault(category => !IsSystemCategory(category))?.Id ?? 0;

            await ApplyFiltersNowAsync(force: true);
            await ShowExpenseAddedMessageAsync();
        }
        catch
        {
            await ShowStatusMessageAsync("Wyst\u0105pi\u0142 b\u0142\u0105d podczas dodawania wydatku.", true);
        }
    }

    private async Task DeleteExpense(int expenseId)
    {
        ClearStatusMessage();

        var budgetId = currentBudget?.Id ?? currentBudgetId;
        if (budgetId == 0)
        {
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Czy na pewno chcesz usun\u0105\u0107?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"http://localhost:5226/api/budget/{budgetId}/expense/{expenseId}");

            if (!response.IsSuccessStatusCode)
            {
                await ShowStatusMessageAsync("Nie uda\u0142o si\u0119 usun\u0105\u0107 wydatku.", true);
                return;
            }

            await ApplyFiltersNowAsync(force: true);
        }
        catch
        {
            await ShowStatusMessageAsync("Wyst\u0105pi\u0142 b\u0142\u0105d podczas usuwania wydatku.", true);
        }
    }

    private void StartEdit(ExpenseDto expense)
    {
        editingExpenseId = expense.Id;
        editingName = expense.Name;
        editingAmount = expense.Amount;
        editingCreatedAt = expense.CreatedAt;
        editingCategoryId = expense.CategoryId;
    }

    private void CancelEdit()
    {
        editingExpenseId = null;
    }

    private async Task SaveEdit(int expenseId)
    {
        if (!await ValidateExpenseAmount(editingAmount))
        {
            return;
        }

        var response = await Http.PutAsJsonAsync(
            $"http://localhost:5226/api/budget/{currentBudget!.Id}/expense/{expenseId}",
            new
            {
                name = editingName,
                amount = editingAmount,
                createdAt = editingCreatedAt,
                categoryId = editingCategoryId == 0 ? 0 : editingCategoryId
            }
        );

        if (response.IsSuccessStatusCode)
        {
            editingExpenseId = null;
            await ApplyFiltersNowAsync(force: true);
        }
        else
        {
            statusMessage = "B\u0142\u0105d zapisu wydatku";
        }
    }

    private async Task ScheduleFiltersAsync()
    {
        if (isDisposed)
        {
            return;
        }

        ResetToFirstPage();
        await PersistViewStateAsync();
        var filterState = GetCurrentFilterState();
        if (filterState == lastScheduledFilterState)
        {
            return;
        }

        lastScheduledFilterState = filterState;
        var cancellationTokenSource = ReplaceFilterDebounceCancellationTokenSource();

        try
        {
            // Keep only the latest pending filter refresh while the user is still typing.
            await Task.Delay(FilterDebounceDelayMs, cancellationTokenSource.Token);
            await ApplyFiltersAsync(cancellationTokenSource.Token);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (ReferenceEquals(filterDebounceCts, cancellationTokenSource))
            {
                filterDebounceCts = null;
            }

            SafeDisposeCancellationTokenSource(cancellationTokenSource);
        }
    }

    private async Task ApplyFiltersNowAsync(bool force = false)
    {
        if (isDisposed)
        {
            return;
        }

        CancelPendingFilterRefresh();
        await ApplyFiltersAsync(force: force);
    }

    private async Task ApplyFiltersAsync(CancellationToken cancellationToken = default, bool force = false)
    {
        if (isDisposed)
        {
            return;
        }

        var filterState = GetCurrentFilterState();
        if (!force && filterState == lastAppliedFilterState)
        {
            lastScheduledFilterState = filterState;
            return;
        }

        var requestCancellationTokenSource = BeginFilterRequest(cancellationToken, out var requestVersion);

        if (minAmountFilter.HasValue && maxAmountFilter.HasValue && minAmountFilter.Value > maxAmountFilter.Value)
        {
            await ShowStatusMessageAsync("Nieprawid\u0142owy zakres kwoty.", true);
            return;
        }

        if (fromDateFilter.HasValue && toDateFilter.HasValue && fromDateFilter.Value.Date > toDateFilter.Value.Date)
        {
            await ShowStatusMessageAsync("Nieprawid\u0142owy okres.", true);
            return;
        }

        var yearMonth = $"{selectedYear}-{selectedMonth:D2}";
        var queryParams = new List<string>();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            queryParams.Add($"search={Uri.EscapeDataString(searchTerm.Trim())}");
        }

        if (minAmountFilter.HasValue)
        {
            queryParams.Add($"minAmount={minAmountFilter.Value.ToString(CultureInfo.InvariantCulture)}");
        }

        if (maxAmountFilter.HasValue)
        {
            queryParams.Add($"maxAmount={maxAmountFilter.Value.ToString(CultureInfo.InvariantCulture)}");
        }

        if (fromDateFilter.HasValue)
        {
            queryParams.Add($"fromDate={Uri.EscapeDataString(fromDateFilter.Value.Date.ToString("O", CultureInfo.InvariantCulture))}");
        }

        if (toDateFilter.HasValue)
        {
            var toDate = toDateFilter.Value.Date.AddDays(1).AddTicks(-1);
            queryParams.Add($"toDate={Uri.EscapeDataString(toDate.ToString("O", CultureInfo.InvariantCulture))}");
        }

        var url = $"http://localhost:5226/api/budget/by-month/{yearMonth}";

        if (queryParams.Count > 0)
        {
            url += $"?{string.Join("&", queryParams)}";
        }

        try
        {
            var data = await Http.GetFromJsonAsync<BudgetDetailsResponse>(url, requestCancellationTokenSource.Token);

            if (!CanApplyFilterResult(requestVersion, requestCancellationTokenSource.Token))
            {
                return;
            }

            if (data is null)
            {
                currentBudget = null;
                lastAppliedFilterState = filterState;
                lastScheduledFilterState = filterState;
                ResetToFirstPage();
                await ShowStatusMessageAsync("Nie znaleziono bud\u017cetu dla wybranego miesi\u0105ca.", true);
                return;
            }

            currentBudget = data;
            currentBudgetId = data.Id;
            lastAppliedFilterState = filterState;
            lastScheduledFilterState = filterState;
            EnsureCurrentPageInRange();
            ClearStatusMessage();
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            if (!isDisposed && CanApplyFilterResult(requestVersion, CancellationToken.None))
            {
                await ShowStatusMessageAsync("B\u0142\u0105d podczas pobierania danych.", true);
            }
        }
        finally
        {
            if (ReferenceEquals(filterRequestCts, requestCancellationTokenSource))
            {
                filterRequestCts = null;
            }

            SafeDisposeCancellationTokenSource(requestCancellationTokenSource);
        }
    }

    private CancellationTokenSource ReplaceFilterDebounceCancellationTokenSource()
    {
        CancelPendingFilterRefresh();
        filterDebounceCts = new CancellationTokenSource();
        return filterDebounceCts;
    }

    private CancellationTokenSource BeginFilterRequest(CancellationToken cancellationToken, out int requestVersion)
    {
        CancelInFlightFilterRequest();
        filterRequestCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        requestVersion = ++filterRequestVersion;
        return filterRequestCts;
    }

    private bool IsLatestFilterRequest(int requestVersion)
    {
        return requestVersion == filterRequestVersion;
    }

    private bool CanApplyFilterResult(int requestVersion, CancellationToken cancellationToken)
    {
        return !isDisposed
            && !cancellationToken.IsCancellationRequested
            && IsLatestFilterRequest(requestVersion);
    }

    private string GetCurrentFilterState()
    {
        var normalizedCategoryIds = selectedCategoryIds
            .OrderBy(categoryId => categoryId)
            .ToArray();

        return string.Join("|",
            searchTerm.Trim(),
            fromDateFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty,
            toDateFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty,
            minAmountFilter?.ToString(CultureInfo.InvariantCulture) ?? string.Empty,
            maxAmountFilter?.ToString(CultureInfo.InvariantCulture) ?? string.Empty,
            string.Join(",", normalizedCategoryIds));
    }

    private BudgetViewState CreateViewState()
    {
        return new BudgetViewState
        {
            SearchTerm = searchTerm,
            FromDate = fromDateFilter,
            ToDate = toDateFilter,
            MinAmount = minAmountFilter,
            MaxAmount = maxAmountFilter,
            SelectedCategoryIds = selectedCategoryIds
                .OrderBy(categoryId => categoryId)
                .ToList(),
            SortColumn = currentSortColumn,
            SortDirection = currentSortDirection
        };
    }

    private async Task RestoreViewStateAsync()
    {
        var restoredViewState = await LoadViewStateAsync();
        if (restoredViewState is null)
        {
            ApplyDefaultViewState();
            return;
        }

        var savedState = restoredViewState.ViewState;
        searchTerm = savedState.SearchTerm?.Trim() ?? string.Empty;
        fromDateFilter = savedState.FromDate;
        toDateFilter = savedState.ToDate;
        minAmountFilter = savedState.MinAmount;
        maxAmountFilter = savedState.MaxAmount;
        currentSortColumn = Enum.IsDefined(savedState.SortColumn)
            ? savedState.SortColumn
            : BudgetSortColumn.Date;
        currentSortDirection = Enum.IsDefined(savedState.SortDirection)
            ? savedState.SortDirection
            : SortDirection.Descending;
        selectedCategoryIds = GetValidSelectedCategoryIds(savedState.SelectedCategoryIds);
        RefreshCategoryFilterUi();
        shouldPersistRestoredViewState = restoredViewState.RequiresPersistenceRewrite;
        ResetToFirstPage();
    }

    private List<int> GetValidSelectedCategoryIds(IEnumerable<int>? categoryIds)
    {
        return categoryIds?
            .Distinct()
            .Where(categoryId => categoryId > 0)
            .ToList()
            ?? new List<int>();
    }

    private void RefreshCategoryFilterUi()
    {
        categoryFilterRenderVersion++;
    }

    private void ApplyDefaultViewState()
    {
        searchTerm = string.Empty;
        fromDateFilter = null;
        toDateFilter = null;
        minAmountFilter = null;
        maxAmountFilter = null;
        selectedCategoryIds.Clear();
        currentSortColumn = BudgetSortColumn.Date;
        currentSortDirection = SortDirection.Descending;
        RefreshCategoryFilterUi();
        ResetToFirstPage();
    }

    private async Task PersistViewStateAsync()
    {
        if (isDisposed || !viewStateInitialized || isRestoringViewState)
        {
            pendingViewStatePersistence = !isDisposed;
            return;
        }

        try
        {
            pendingViewStatePersistence = false;
            var viewState = CreateViewState();
            var payload = JsonSerializer.Serialize(viewState, BudgetViewStateJsonOptions);
            await JS.InvokeVoidAsync("localStorage.setItem", BudgetViewStateStorageKey, payload);
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSException)
        {
        }
    }

    private async Task<RestoredBudgetViewState?> LoadViewStateAsync()
    {
        if (isDisposed)
        {
            return null;
        }

        try
        {
            var payload = await JS.InvokeAsync<string?>("localStorage.getItem", BudgetViewStateStorageKey);

            if (string.IsNullOrWhiteSpace(payload))
            {
                return null;
            }

            using var document = JsonDocument.Parse(payload);
            var viewState = JsonSerializer.Deserialize<BudgetViewState>(payload, BudgetViewStateJsonOptions);
            if (viewState is null)
            {
                return null;
            }

            var restoredCategoryIds = GetValidSelectedCategoryIds(viewState.SelectedCategoryIds);
            var requiresPersistenceRewrite = false;

            if (restoredCategoryIds.Count == 0)
            {
                var legacyCategoryIds = GetLegacySelectedCategoryIds(document.RootElement);
                if (legacyCategoryIds.Count > 0)
                {
                    restoredCategoryIds = legacyCategoryIds;
                    requiresPersistenceRewrite = true;
                }
            }

            viewState.SelectedCategoryIds = restoredCategoryIds;
            return new RestoredBudgetViewState(viewState, requiresPersistenceRewrite);
        }
        catch (InvalidOperationException)
        {
            throw;
        }
        catch (JSException)
        {
            throw;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private List<int> GetLegacySelectedCategoryIds(JsonElement rootElement)
    {
        if (!rootElement.TryGetProperty("SelectedCategories", out var selectedCategoriesElement)
            || selectedCategoriesElement.ValueKind != JsonValueKind.Array)
        {
            return new List<int>();
        }

        return selectedCategoriesElement
            .EnumerateArray()
            .Where(item => item.ValueKind == JsonValueKind.String)
            .Select(item => item.GetString())
            .Where(categoryName => !string.IsNullOrWhiteSpace(categoryName))
            .Select(categoryName => categories
                .FirstOrDefault(category =>
                    string.Equals(category.Name, categoryName, StringComparison.CurrentCultureIgnoreCase))
                ?.Id)
            .Where(categoryId => categoryId.HasValue)
            .Select(categoryId => categoryId!.Value)
            .Distinct()
            .ToList();
    }

    private bool IsAnyFilterActive()
    {
        return !string.IsNullOrWhiteSpace(searchTerm)
            || selectedCategoryIds.Any()
            || fromDateFilter != null
            || toDateFilter != null
            || minAmountFilter != null
            || maxAmountFilter != null;
    }

    private void CancelPendingFilterRefresh()
    {
        if (filterDebounceCts is null)
        {
            return;
        }

        SafeCancelCancellationTokenSource(filterDebounceCts);
        SafeDisposeCancellationTokenSource(filterDebounceCts);
        filterDebounceCts = null;
    }

    private void CancelInFlightFilterRequest()
    {
        if (filterRequestCts is null)
        {
            return;
        }

        SafeCancelCancellationTokenSource(filterRequestCts);
        SafeDisposeCancellationTokenSource(filterRequestCts);
        filterRequestCts = null;
    }

    private static void SafeCancelCancellationTokenSource(CancellationTokenSource cancellationTokenSource)
    {
        try
        {
            cancellationTokenSource.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private static void SafeDisposeCancellationTokenSource(CancellationTokenSource cancellationTokenSource)
    {
        try
        {
            cancellationTokenSource.Dispose();
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task ResetFilters()
    {
        if (isDisposed)
        {
            return;
        }

        var hadActiveFilters = IsAnyFilterActive();
        if (!hadActiveFilters && HasDefaultSort)
        {
            return;
        }

        searchTerm = string.Empty;
        selectedCategoryIds.Clear();
        RefreshCategoryFilterUi();
        fromDateFilter = null;
        toDateFilter = null;
        minAmountFilter = null;
        maxAmountFilter = null;
        showDateFilter = false;
        showAmountFilter = false;
        isDropdownOpen = false;
        lastScheduledFilterState = string.Empty;
        currentSortColumn = BudgetSortColumn.Date;
        currentSortDirection = SortDirection.Descending;
        ResetToFirstPage();
        await PersistViewStateAsync();

        await ApplyFiltersNowAsync();
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private async Task ToggleCategoryAsync(int categoryId)
    {
        if (isRestoringViewState)
        {
            return;
        }

        if (selectedCategoryIds.Contains(categoryId))
        {
            selectedCategoryIds.Remove(categoryId);
        }
        else
        {
            selectedCategoryIds.Add(categoryId);
        }

        RefreshCategoryFilterUi();
        ResetToFirstPage();
        await ApplyFiltersNowAsync();
        await PersistViewStateAsync();
    }

    private async Task ClearCategories()
    {
        if (isRestoringViewState)
        {
            return;
        }

        if (!selectedCategoryIds.Any())
        {
            return;
        }

        selectedCategoryIds.Clear();
        RefreshCategoryFilterUi();
        ResetToFirstPage();
        await ApplyFiltersNowAsync();
        await PersistViewStateAsync();
    }

    private async Task ToggleDateFilterAsync()
    {
        if (isDisposed)
        {
            return;
        }

        showDateFilter = !showDateFilter;

        if (showDateFilter)
        {
            showAmountFilter = false;
            await RequestRenderAsync();
            await PositionPanel("okresBtn", "okresPanel");
        }
    }

    private async Task ToggleAmountFilterAsync()
    {
        if (isDisposed)
        {
            return;
        }

        showAmountFilter = !showAmountFilter;

        if (showAmountFilter)
        {
            showDateFilter = false;
            await RequestRenderAsync();
            await PositionPanel("kwotaBtn", "kwotaPanel");
        }
    }

    private void CloseFilterPanels()
    {
        showDateFilter = false;
        showAmountFilter = false;
        isDropdownOpen = false;
    }

    private async Task ShowExpenseAddedMessageAsync()
    {
        if (isDisposed)
        {
            return;
        }
        expenseAddedMessage = "Wydatek zosta\u0142 dodany";
        await RequestRenderAsync();
        await Task.Delay(2000);
        if (isDisposed)
        {
            return;
        }

        expenseAddedMessage = string.Empty;
        await RequestRenderAsync();
    }

    private async Task ShowStatusMessageAsync(string message, bool isError)
    {
        if (isDisposed)
        {
            return;
        }

        statusMessageVersion++;
        var version = statusMessageVersion;
        statusMessage = message;
        isStatusError = isError;
        await RequestRenderAsync();
        await Task.Delay(2500);

        if (!isDisposed && version == statusMessageVersion)
        {
            statusMessage = string.Empty;
            isStatusError = false;
            await RequestRenderAsync();
        }
    }

    private void ClearStatusMessage()
    {
        statusMessageVersion++;
        statusMessage = string.Empty;
        isStatusError = false;
    }

    private async Task RequestRenderAsync()
    {
        if (isDisposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(() =>
            {
                if (!isDisposed)
                {
                    StateHasChanged();
                }
            });
        }
        catch (InvalidOperationException)
        {
        }
    }

    private static string FormatCurrency(decimal value)
    {
        return value.ToString("C", new CultureInfo("pl-PL"));
    }

    private static string FormatDateFilterValue(DateTime? value)
    {
        return value?.ToString("dd.MM") ?? "..";
    }

    private static string FormatAmountFilterValue(decimal? value)
    {
        return value?.ToString("0.##", CultureInfo.InvariantCulture) ?? "..";
    }

    private async Task<bool> ValidateExpenseAmount(decimal value)
    {
        if (value < MinExpenseAmount)
        {
            await ShowStatusMessageAsync("Kwota musi by\u0107 wi\u0119ksza lub r\u00f3wna 0.01 PLN.", true);
            return false;
        }

        if (value > MaxExpenseAmount)
        {
            await ShowStatusMessageAsync("Kwota nie mo\u017ce by\u0107 wi\u0119ksza ni\u017c 999999999 PLN.", true);
            return false;
        }

        return true;
    }

    public void Dispose()
    {
        isDisposed = true;
        CancelPendingFilterRefresh();
        CancelInFlightFilterRequest();
    }

    private enum BudgetSortColumn
    {
        Name,
        Date,
        Category,
        Amount
    }

    private enum SortDirection
    {
        Ascending,
        Descending
    }

    private sealed class BudgetViewState
    {
        public string SearchTerm { get; set; } = string.Empty;
        public DateTime? FromDate { get; set; }
        public DateTime? ToDate { get; set; }
        public decimal? MinAmount { get; set; }
        public decimal? MaxAmount { get; set; }
        [JsonPropertyName("selectedCategoryIds")]
        public List<int> SelectedCategoryIds { get; set; } = new();
        public BudgetSortColumn SortColumn { get; set; } = BudgetSortColumn.Date;
        public SortDirection SortDirection { get; set; } = SortDirection.Descending;
    }

    private sealed class RestoredBudgetViewState
    {
        public RestoredBudgetViewState(BudgetViewState viewState, bool requiresPersistenceRewrite)
        {
            ViewState = viewState;
            RequiresPersistenceRewrite = requiresPersistenceRewrite;
        }

        public BudgetViewState ViewState { get; }
        public bool RequiresPersistenceRewrite { get; }
    }

    public class Category
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}

