@page "/budzet"
@rendermode InteractiveServer
@inject HttpClient Http
@using System.Globalization

<PageTitle>Budżet</PageTitle>

<div class="budget-page">
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="status-overlay">
            <div class="status-popup @(isStatusError ? "status-popup-error" : "status-popup-success")">
                @statusMessage
            </div>
        </div>
    }

    @if (currentBudget is not null)
    {
        <section class="budget-card">
            <div class="position-relative">
                <h3 class="mt-4 mb-4 text-center text-uppercase fw-bold" style="letter-spacing:1px;">
                    Podsumowanie miesiąca
                </h3>

                <div class="row">
                    <div class="col-md-3">
                        <div class="card p-3 text-center shadow-sm budget-income-card">
                            <button type="button"
                                    class="btn btn-link budget-income-edit-button"
                                    title="Edytuj przychód"
                                    aria-label="Edytuj przychód"
                                    @onclick="BeginIncomeEdit">
                                &#9998;
                            </button>

                            <div class="budget-income-content">
                                <div class="text-muted">Przychód</div>

                                @if (isEditingIncome)
                                {
                                    <div class="budget-income-editor" @onclick:stopPropagation="true">
                                        <div class="input-group budget-currency-group budget-income-input-group">
                                            <input type="number"
                                                   class="form-control text-end fw-bold amount-number-input budget-income-inline-input"
                                                   min="0"
                                                   max="999999999"
                                                   step="0.01"
                                                   @bind="editingIncomeText" />
                                            <span class="input-group-text">PLN</span>
                                        </div>

                                        <div class="budget-income-actions">
                                            <button type="button"
                                                    class="btn btn-success btn-sm budget-income-action-button"
                                                    title="Zapisz przychód"
                                                    aria-label="Zapisz przychód"
                                                    @onclick="SaveIncomeAsync">
                                                &#10003;
                                            </button>
                                            <button type="button"
                                                    class="btn btn-outline-secondary btn-sm budget-income-action-button"
                                                    title="Anuluj edycję przychodu"
                                                    aria-label="Anuluj edycję przychodu"
                                                    @onclick="CancelIncomeEdit">
                                                &#10005;
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="fs-4 fw-bold budget-income-value">@FormatCurrency(currentBudget.Income)</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card p-3 text-center shadow-sm">
                            <div class="text-muted">Wydatki</div>
                            <div class="fs-4 fw-bold">@FormatCurrency(currentBudget.TotalExpenses)</div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card p-3 text-center shadow-sm">
                            <div class="text-muted">Pozostało</div>
                            <div class="fs-4 fw-bold">@FormatCurrency(currentBudget.Remaining)</div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card p-3 text-center shadow-sm">
                            <div class="text-muted">Procent</div>
                            <div class="fs-4 fw-bold">@FormatPercentage(currentBudget.Percentage) %</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <section class="budget-card">
        <h2>Dodaj budżet</h2>

        <form @onsubmit="CreateBudgetAsync" @onsubmit:preventDefault>
            <div class="budget-grid">
                <div>
                    <label class="form-label" for="month">Miesiąc</label>
                    <input id="month"
                           class="form-control"
                           placeholder="2026-03"
                           @bind="newBudgetMonth"
                           @bind:after="LoadSelectedMonthBudgetAsync" />
                </div>

                <div>
                    <label class="form-label" for="income">Przychód</label>
                    <div class="input-group budget-currency-group amount-field-group">
                        <input id="income" class="form-control" placeholder="6500" @bind="newBudgetIncomeText" />
                        <span class="input-group-text">PLN</span>
                    </div>
                </div>
            </div>

            <button class="btn btn-primary" type="submit">Dodaj budżet</button>
        </form>
    </section>
</div>

@code {
    private int currentBudgetId = 1;
    private string newBudgetMonth = DateTime.Today.ToString("yyyy-MM");
    private string newBudgetIncomeText = string.Empty;
    private string statusMessage = string.Empty;
    private bool isStatusError;
    private int statusMessageVersion;
    private bool isEditingIncome;
    private string editingIncomeText = string.Empty;
    private BudgetDetailsResponse? currentBudget;

    protected override async Task OnInitializedAsync()
    {
        await LoadSelectedMonthBudgetAsync();
    }

    private async Task CreateBudgetAsync()
    {
        ClearStatusMessage();

        if (!TryParseDecimal(newBudgetIncomeText, out var income) || income < 0)
        {
            await ShowStatusMessageAsync("Nieprawidlowa wartosc przychodu.", true);
            return;
        }

        var response = await Http.PostAsJsonAsync("http://localhost:5226/api/budget", new CreateMonthlyBudgetRequest
        {
            Month = newBudgetMonth,
            Income = income
        });

        if (!response.IsSuccessStatusCode)
        {
            await ShowStatusMessageAsync("Nie udalo sie dodac budzetu.", true);
            return;
        }

        var createdBudget = await response.Content.ReadFromJsonAsync<BudgetDto>();

        if (createdBudget is null)
        {
            await ShowStatusMessageAsync("API zwrocilo pusty wynik.", true);
            return;
        }

        currentBudgetId = createdBudget.Id;
        isEditingIncome = false;
        await LoadSelectedMonthBudgetAsync();
        await ShowStatusMessageAsync("Budzet zostal dodany.", false);
    }

    private async Task LoadSelectedMonthBudgetAsync()
    {
        ClearStatusMessage();

        if (!IsValidMonth(newBudgetMonth))
        {
            currentBudget = null;
            isEditingIncome = false;
            return;
        }

        var url = $"http://localhost:5226/api/budget/month/{newBudgetMonth}";

        try
        {
            var data = await Http.GetFromJsonAsync<BudgetDetailsResponse>(url);

            if (data is null)
            {
                currentBudget = null;
                isEditingIncome = false;
                return;
            }

            currentBudget = data;
            currentBudgetId = data.Id;
            newBudgetIncomeText = data.Income == 0
                ? string.Empty
                : data.Income.ToString("0.##", CultureInfo.InvariantCulture);

            if (!isEditingIncome)
            {
                editingIncomeText = data.Income.ToString("0.##", CultureInfo.InvariantCulture);
            }
        }
        catch
        {
            currentBudget = null;
            isEditingIncome = false;
            await ShowStatusMessageAsync("Blad podczas pobierania danych.", true);
        }
    }

    private void BeginIncomeEdit()
    {
        if (currentBudget is null)
        {
            return;
        }

        editingIncomeText = currentBudget.Income.ToString("0.##", CultureInfo.InvariantCulture);
        isEditingIncome = true;
    }

    private async Task SaveIncomeAsync()
    {
        if (currentBudget is null)
        {
            return;
        }

        var normalizedInput = string.IsNullOrWhiteSpace(editingIncomeText)
            ? "0"
            : editingIncomeText;

        if (!TryParseDecimal(normalizedInput, out var income) || income < 0)
        {
            await ShowStatusMessageAsync("Nieprawidlowa wartosc przychodu.", true);
            return;
        }

        var response = await Http.PutAsJsonAsync(
            $"http://localhost:5226/api/budget/{currentBudget.Id}",
            new { income }
        );

        if (!response.IsSuccessStatusCode)
        {
            await ShowStatusMessageAsync("Blad zapisu.", true);
            return;
        }

        isEditingIncome = false;
        await LoadSelectedMonthBudgetAsync();
        await ShowStatusMessageAsync("Przychod zostal zapisany.", false);
    }

    private void CancelIncomeEdit()
    {
        if (currentBudget is not null)
        {
            editingIncomeText = currentBudget.Income.ToString("0.##", CultureInfo.InvariantCulture);
        }

        isEditingIncome = false;
    }

    private async Task ShowStatusMessageAsync(string message, bool isError)
    {
        statusMessageVersion++;
        var version = statusMessageVersion;
        statusMessage = message;
        isStatusError = isError;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2500);

        if (version == statusMessageVersion)
        {
            statusMessage = string.Empty;
            isStatusError = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClearStatusMessage()
    {
        statusMessageVersion++;
        statusMessage = string.Empty;
        isStatusError = false;
    }

    private static bool TryParseDecimal(string input, out decimal value)
    {
        return decimal.TryParse(input, NumberStyles.Number, CultureInfo.CurrentCulture, out value)
            || decimal.TryParse(input, NumberStyles.Number, CultureInfo.InvariantCulture, out value);
    }

    private static bool IsValidMonth(string month)
    {
        return DateTime.TryParseExact(month, "yyyy-MM", CultureInfo.InvariantCulture, DateTimeStyles.None, out _);
    }

    private static string FormatCurrency(decimal value)
    {
        return value.ToString("C", new CultureInfo("pl-PL"));
    }

    private static string FormatPercentage(decimal value)
    {
        return value.ToString("0.00", new CultureInfo("pl-PL"));
    }
}
