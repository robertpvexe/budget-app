@page "/"
@rendermode InteractiveServer
@inject HttpClient Http
@using System.Globalization

<PageTitle>Home</PageTitle>

<div class="budget-page">
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="status-overlay">
            <div class="status-popup @(isStatusError ? "status-popup-error" : "status-popup-success")">
                @statusMessage
            </div>
        </div>
    }

    @if (showSavePopup)
    {
        <div class="save-overlay">
            <div class="save-modal">
                <p>Czy zapisać zmiany?</p>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-secondary" @onclick="CancelChanges">Nie</button>
                    <button type="button" class="btn btn-primary" @onclick="async () => await ConfirmSave()">Tak</button>
                </div>
            </div>
        </div>
    }

    @if (currentBudget is not null)
    {
        <section class="budget-card">
            <div class="position-relative @(isEditMode ? "edit-mode-active" : "")">
                <button type="button" class="btn @(isEditMode ? "btn-outline-warning" : "btn-outline-secondary") btn-sm position-absolute"
                        style="top: 10px; right: 10px;"
                        @onclick="ToggleEditMode">
                    ⚙️
                </button>

                <h3 class="mt-4 mb-4 text-center text-uppercase fw-bold" style="letter-spacing:1px;">
                    Podsumowanie miesiąca
                </h3>

                @if (isEditMode)
                {
                    <div class="edit-mode-overlay">
                        <div class="edit-mode-banner d-flex align-items-center justify-content-between">
                            <span>✏️ Tryb edycji włączony</span>
                            <button type="button" class="btn-close ms-3" @onclick="ToggleEditMode"></button>
                        </div>
                    </div>
                }

                <div class="row">
                    <div class="col-md-3">
                        <div class="card p-3 text-center shadow-sm">
                            <div class="text-muted">Przychód</div>
                            @if (isEditMode)
                            {
                                <div class="input-group budget-currency-group amount-field-group mx-auto">
                                    <input type="number"
                                           class="form-control text-end fw-bold amount-number-input"
                                           min="0.01"
                                           max="999999999"
                                           step="0.01"
                                           @bind="currentBudget.Income" />
                                    <span class="input-group-text">PLN</span>
                                </div>
                            }
                            else
                            {
                                <div class="fs-4 fw-bold">@FormatCurrency(currentBudget.Income)</div>
                            }
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card p-3 text-center shadow-sm">
                            <div class="text-muted">Wydatki</div>
                            <div class="fs-4 fw-bold">@FormatCurrency(currentBudget.TotalExpenses)</div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card p-3 text-center shadow-sm">
                            <div class="text-muted">Pozostało</div>
                            <div class="fs-4 fw-bold">@FormatCurrency(currentBudget.Remaining)</div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card p-3 text-center shadow-sm">
                            <div class="text-muted">Procent</div>
                            <div class="fs-4 fw-bold">@currentBudget.Percentage %</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <section class="budget-card">
        <h2>Dodaj budżet</h2>

        <form @onsubmit="CreateBudgetAsync" @onsubmit:preventDefault>
            <div class="budget-grid">
                <div>
                    <label class="form-label" for="month">Miesiąc</label>
                    <input id="month" class="form-control" placeholder="2026-03" @bind="newBudgetMonth" />
                </div>

                <div>
                    <label class="form-label" for="income">Przychód</label>
                    <div class="input-group budget-currency-group amount-field-group">
                        <input id="income" class="form-control" placeholder="6500" @bind="newBudgetIncomeText" />
                        <span class="input-group-text">PLN</span>
                    </div>
                </div>
            </div>

            <button class="btn btn-primary" type="submit">Dodaj budżet</button>
        </form>
    </section>
</div>

@code {
    private int currentBudgetId = 1;
    private int selectedYear = DateTime.Now.Year;
    private int selectedMonth = DateTime.Now.Month;
    private string newBudgetMonth = DateTime.Today.ToString("yyyy-MM");
    private string newBudgetIncomeText = string.Empty;
    private string statusMessage = string.Empty;
    private bool isStatusError;
    private int statusMessageVersion;
    private bool isEditMode;
    private decimal originalIncome;
    private bool showSavePopup;
    private BudgetDetailsResponse? currentBudget;

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.Now;
        selectedYear = now.Year;
        selectedMonth = now.Month;

        await ShowBudget();
    }

    private async Task CreateBudgetAsync()
    {
        ClearStatusMessage();

        if (!TryParseDecimal(newBudgetIncomeText, out var income))
        {
            await ShowStatusMessageAsync("Nieprawidlowa wartosc przychodu.", true);
            return;
        }

        var response = await Http.PostAsJsonAsync("http://localhost:5226/api/budget", new CreateMonthlyBudgetRequest
        {
            Month = newBudgetMonth,
            Income = income
        });

        if (!response.IsSuccessStatusCode)
        {
            await ShowStatusMessageAsync("Nie udalo sie dodac budzetu.", true);
            return;
        }

        var createdBudget = await response.Content.ReadFromJsonAsync<BudgetDto>();

        if (createdBudget is null)
        {
            await ShowStatusMessageAsync("API zwrocilo pusty wynik.", true);
            return;
        }

        currentBudgetId = createdBudget.Id;
        await ShowBudget();
        await ShowStatusMessageAsync("Budzet zostal dodany.", false);
    }

    private async Task ShowBudget()
    {
        var url = $"http://localhost:5226/api/Budget/filter?year={selectedYear}&month={selectedMonth}";

        try
        {
            var data = await Http.GetFromJsonAsync<BudgetDetailsResponse>(url);

            if (data is null)
            {
                currentBudget = null;
                await ShowStatusMessageAsync("Nie znaleziono budzetu dla wybranego miesiaca.", true);
                return;
            }

            currentBudget = data;
            currentBudgetId = data.Id;
            ClearStatusMessage();
        }
        catch
        {
            currentBudget = null;
            await ShowStatusMessageAsync("Blad podczas pobierania danych.", true);
        }
    }

    private void ToggleEditMode()
    {
        if (!isEditMode)
        {
            originalIncome = currentBudget?.Income ?? 0;
            isEditMode = true;
            return;
        }

        if (currentBudget != null && currentBudget.Income != originalIncome)
        {
            showSavePopup = true;
            return;
        }

        isEditMode = false;
    }

    private async Task ConfirmSave()
    {
        if (currentBudget != null)
        {
            var response = await Http.PutAsJsonAsync(
                $"http://localhost:5226/api/budget/{currentBudget.Id}",
                new { income = currentBudget.Income }
            );

            if (!response.IsSuccessStatusCode)
            {
                statusMessage = "Błąd zapisu.";
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        showSavePopup = false;
        isEditMode = false;

        await InvokeAsync(StateHasChanged);
    }

    private void CancelChanges()
    {
        if (currentBudget != null)
        {
            currentBudget.Income = originalIncome;
        }

        showSavePopup = false;
        isEditMode = false;
    }

    private async Task ShowStatusMessageAsync(string message, bool isError)
    {
        statusMessageVersion++;
        var version = statusMessageVersion;
        statusMessage = message;
        isStatusError = isError;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2500);

        if (version == statusMessageVersion)
        {
            statusMessage = string.Empty;
            isStatusError = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClearStatusMessage()
    {
        statusMessageVersion++;
        statusMessage = string.Empty;
        isStatusError = false;
    }

    private static bool TryParseDecimal(string input, out decimal value)
    {
        return decimal.TryParse(input, NumberStyles.Number, CultureInfo.CurrentCulture, out value)
            || decimal.TryParse(input, NumberStyles.Number, CultureInfo.InvariantCulture, out value);
    }

    private static string FormatCurrency(decimal value)
    {
        return value.ToString("C", new CultureInfo("pl-PL"));
    }
}
