@page "/"
@rendermode InteractiveServer
@inject HttpClient Http
@using System.Globalization

<PageTitle>Home</PageTitle>

<div class="budget-page">
    <section class="budget-card">
        <h3>Dashboard (w budowie)</h3>
    </section>
</div>

@code {
    private int currentBudgetId = 1;
    private string newBudgetMonth = DateTime.Today.ToString("yyyy-MM");
    private string newBudgetIncomeText = string.Empty;
    private string statusMessage = string.Empty;
    private bool isStatusError;
    private int statusMessageVersion;
    private bool isEditingIncome;
    private string editingIncomeText = string.Empty;
    private BudgetDetailsResponse? currentBudget;

    protected override async Task OnInitializedAsync()
    {
        await LoadSelectedMonthBudgetAsync();
    }

    private async Task CreateBudgetAsync()
    {
        ClearStatusMessage();

        if (!TryParseDecimal(newBudgetIncomeText, out var income) || income < 0)
        {
            await ShowStatusMessageAsync("Nieprawidlowa wartosc przychodu.", true);
            return;
        }

        var response = await Http.PostAsJsonAsync("http://localhost:5226/api/budget", new CreateMonthlyBudgetRequest
        {
            Month = newBudgetMonth,
            Income = income
        });

        if (!response.IsSuccessStatusCode)
        {
            await ShowStatusMessageAsync("Nie udalo sie dodac budzetu.", true);
            return;
        }

        var createdBudget = await response.Content.ReadFromJsonAsync<BudgetDto>();

        if (createdBudget is null)
        {
            await ShowStatusMessageAsync("API zwrocilo pusty wynik.", true);
            return;
        }

        currentBudgetId = createdBudget.Id;
        isEditingIncome = false;
        await LoadSelectedMonthBudgetAsync();
        await ShowStatusMessageAsync("Budzet zostal dodany.", false);
    }

    private async Task LoadSelectedMonthBudgetAsync()
    {
        ClearStatusMessage();

        if (!IsValidMonth(newBudgetMonth))
        {
            currentBudget = null;
            isEditingIncome = false;
            return;
        }

        var url = $"http://localhost:5226/api/budget/month/{newBudgetMonth}";

        try
        {
            var data = await Http.GetFromJsonAsync<BudgetDetailsResponse>(url);

            if (data is null)
            {
                currentBudget = null;
                isEditingIncome = false;
                return;
            }

            currentBudget = data;
            currentBudgetId = data.Id;
            newBudgetIncomeText = data.Income == 0
                ? string.Empty
                : data.Income.ToString("0.##", CultureInfo.InvariantCulture);

            if (!isEditingIncome)
            {
                editingIncomeText = data.Income.ToString("0.##", CultureInfo.InvariantCulture);
            }
        }
        catch
        {
            currentBudget = null;
            isEditingIncome = false;
            await ShowStatusMessageAsync("Blad podczas pobierania danych.", true);
        }
    }

    private void BeginIncomeEdit()
    {
        if (currentBudget is null)
        {
            return;
        }

        editingIncomeText = currentBudget.Income.ToString("0.##", CultureInfo.InvariantCulture);
        isEditingIncome = true;
    }

    private async Task SaveIncomeAsync()
    {
        if (currentBudget is null)
        {
            return;
        }

        var normalizedInput = string.IsNullOrWhiteSpace(editingIncomeText)
            ? "0"
            : editingIncomeText;

        if (!TryParseDecimal(normalizedInput, out var income) || income < 0)
        {
            await ShowStatusMessageAsync("Nieprawidlowa wartosc przychodu.", true);
            return;
        }

        var response = await Http.PutAsJsonAsync(
            $"http://localhost:5226/api/budget/{currentBudget.Id}",
            new { income }
        );

        if (!response.IsSuccessStatusCode)
        {
            await ShowStatusMessageAsync("Blad zapisu.", true);
            return;
        }

        isEditingIncome = false;
        await LoadSelectedMonthBudgetAsync();
        await ShowStatusMessageAsync("Przychod zostal zapisany.", false);
    }

    private void CancelIncomeEdit()
    {
        if (currentBudget is not null)
        {
            editingIncomeText = currentBudget.Income.ToString("0.##", CultureInfo.InvariantCulture);
        }

        isEditingIncome = false;
    }

    private async Task ShowStatusMessageAsync(string message, bool isError)
    {
        statusMessageVersion++;
        var version = statusMessageVersion;
        statusMessage = message;
        isStatusError = isError;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2500);

        if (version == statusMessageVersion)
        {
            statusMessage = string.Empty;
            isStatusError = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClearStatusMessage()
    {
        statusMessageVersion++;
        statusMessage = string.Empty;
        isStatusError = false;
    }

    private static bool TryParseDecimal(string input, out decimal value)
    {
        return decimal.TryParse(input, NumberStyles.Number, CultureInfo.CurrentCulture, out value)
            || decimal.TryParse(input, NumberStyles.Number, CultureInfo.InvariantCulture, out value);
    }

    private static bool IsValidMonth(string month)
    {
        return DateTime.TryParseExact(month, "yyyy-MM", CultureInfo.InvariantCulture, DateTimeStyles.None, out _);
    }

    private static string FormatCurrency(decimal value)
    {
        return value.ToString("C", new CultureInfo("pl-PL"));
    }

    private static string FormatPercentage(decimal value)
    {
        return value.ToString("0.00", new CultureInfo("pl-PL"));
    }
}


