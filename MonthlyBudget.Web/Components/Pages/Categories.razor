@page "/categories"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Kategorie</PageTitle>

<div class="categories-page">
    <div class="categories-toolbar">
    <section class="categories-card categories-card-form">
        <div class="categories-form-row">
            <div class="categories-form-field">
                <input @bind="newCategoryName" placeholder="Nowa kategoria" class="form-control" maxlength="50" />
                @if (newCategoryName?.Length > 50)
                {
                    <div class="text-danger small">Maksymalnie 50 znaków</div>
                }
            </div>

            <div class="categories-form-action">
                <button type="button" class="btn btn-primary categories-submit" @onclick="AddCategory">Dodaj</button>
            </div>
        </div>
    </section>

    <section class="categories-card categories-card-form">
        <div class="categories-form-row">
            <div class="categories-form-field">
                <input @bind="categorySearchTerm"
                       @bind:event="oninput"
                       @bind:after="OnCategorySearchChanged"
                       placeholder="Podaj nazwę"
                       class="form-control"
                       maxlength="50" />
            </div>

            <div class="categories-form-action">
                <button type="button" class="btn btn-primary categories-submit" @onclick="ApplyCategorySearch">Szukaj</button>
            </div>
        </div>
    </section>
    </div>

    <section class="categories-card categories-card-main">
        <div class="categories-card-main-content" @ref="adaptivePaginationContainer">
        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="categories-status @(isStatusError ? "categories-status-error" : "categories-status-success")">
                @statusMessage
            </div>
        }

        <div class="categories-list-header">
            <span>Nazwa kategorii</span>
            <span class="categories-actions-header">Akcje</span>
        </div>

        @if (categories == null)
        {
            <p class="categories-loading">Ładowanie...</p>
        }
        else
        {
            <ul class="categories-list">
                @foreach (var category in PagedCategories)
                {
                    var isEditing = editingCategoryId == category.Id;
                    var isProtected = IsProtectedCategory(category);

                    <li class="categories-list-item">
                        @if (isEditing)
                        {
                            <div class="categories-edit-field">
                                <input class="form-control form-control-sm categories-edit-input"
                                       @bind="editingCategoryName"
                                       @bind:event="oninput"
                                       maxlength="50" />
                                @if (editingCategoryName?.Length > 50)
                                {
                                    <div class="text-danger small">Maksymalnie 50 znaków</div>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="categories-name">@category.Name</span>
                        }

                        <div class="categories-actions">
                            @if (!isProtected)
                            {
                                @if (isEditing)
                                {
                                    <button type="button" class="btn btn-success btn-sm" @onclick="SaveCategoryEdit">Zapisz</button>
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CancelEdit">Anuluj</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => StartEdit(category)">Edytuj</button>
                                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => DeleteCategory(category)">Usuń</button>
                                }
                            }
                        </div>
                    </li>
                }
            </ul>

            @if (ShouldShowPagination)
            {
                <div class="categories-pagination">
                    <button type="button"
                            class="categories-page-button categories-pagination-nav"
                            @onclick="GoToPreviousPage"
                            disabled="@(CurrentPage <= 1)">
                        Poprzednia
                    </button>

                    <div class="categories-pagination-pages">
                        @foreach (var pageNumber in PageNumbers)
                        {
                            <button type="button"
                                    class="@GetPageButtonClass(pageNumber)"
                                    @onclick="() => GoToPage(pageNumber)"
                                    aria-current="@(pageNumber == CurrentPage ? "page" : null)">
                                @pageNumber
                            </button>
                        }
                    </div>

                    <button type="button"
                            class="categories-page-button categories-pagination-nav"
                            @onclick="GoToNextPage"
                            disabled="@(CurrentPage >= TotalPages)">
                        Następna
                    </button>
                </div>
            }
        }
        </div>
    </section>
</div>

@code {
    private const int DefaultPageSize = 13;
    private const int MinAdaptivePageSize = 6;
    private const int MaxAdaptivePageSize = 100;

    private List<Category>? categories;
    private string newCategoryName = string.Empty;
    private int? editingCategoryId;
    private string editingCategoryName = string.Empty;
    private string categorySearchTerm = string.Empty;
    private string statusMessage = string.Empty;
    private bool isStatusError;
    private int currentPage = 1;
    private int pageSize = DefaultPageSize;
    private ElementReference adaptivePaginationContainer;
    private AdaptivePageSizer? adaptivePageSizer;
    private bool isAdaptivePageSizerRegistered;

    private int PageSize => Math.Clamp(pageSize, MinAdaptivePageSize, MaxAdaptivePageSize);

    private IEnumerable<Category> VisibleCategories => categories?
        .Where(category => !IsProtectedCategory(category))
        .Where(MatchesCategorySearch) ?? Enumerable.Empty<Category>();

    private IEnumerable<Category> PagedCategories => VisibleCategories
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize);

    private int VisibleCategoryCount => VisibleCategories.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(VisibleCategoryCount / (double)PageSize));
    private int CurrentPage => Math.Clamp(currentPage, 1, TotalPages);
    private bool ShouldShowPagination => VisibleCategoryCount > PageSize;
    private IEnumerable<int> PageNumbers => Enumerable.Range(1, TotalPages);

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await EnsureAdaptivePageSizerRegisteredAsync();
    }

    private async Task EnsureAdaptivePageSizerRegisteredAsync()
    {
        if (isAdaptivePageSizerRegistered || categories is null)
        {
            return;
        }

        adaptivePageSizer = new AdaptivePageSizer(JS, OnAdaptivePageSizeChangedAsync);
        await adaptivePageSizer.RegisterAsync(
            adaptivePaginationContainer,
            ".categories-list-item",
            new AdaptivePageSizerOptions
            {
                MinItems = MinAdaptivePageSize,
                MaxItems = MaxAdaptivePageSize,
                FallbackItemHeight = 44,
                ReservedSelector = ".categories-pagination",
                UseViewportBottom = true
            });

        isAdaptivePageSizerRegistered = true;
    }

    private async Task OnAdaptivePageSizeChangedAsync(int nextPageSize)
    {
        pageSize = nextPageSize;
        EnsureCurrentPageInRange();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadCategories()
    {
        categories = await Http.GetFromJsonAsync<List<Category>>("http://localhost:5226/api/Budget/categories") ?? new();
        EnsureCurrentPageInRange();
    }

    private async Task AddCategory()
    {
        ClearStatus();

        var trimmedName = newCategoryName.Trim();
        if (string.IsNullOrWhiteSpace(trimmedName) || trimmedName.Length > 50)
            return;

        var response = await Http.PostAsJsonAsync("http://localhost:5226/api/Budget/categories", trimmedName);
        if (!response.IsSuccessStatusCode)
        {
            await ShowErrorAsync("Nie udało się dodać kategorii.");
            return;
        }

        newCategoryName = string.Empty;
        await LoadCategories();
    }

    private void StartEdit(Category category)
    {
        ClearStatus();
        editingCategoryId = category.Id;
        editingCategoryName = category.Name;
    }

    private void CancelEdit()
    {
        editingCategoryId = null;
        editingCategoryName = string.Empty;
        ClearStatus();
    }

    private async Task SaveCategoryEdit()
    {
        ClearStatus();

        if (editingCategoryId is null)
        {
            await ShowErrorAsync("Nie wybrano kategorii do zapisania.");
            return;
        }

        var trimmedName = editingCategoryName.Trim();
        if (string.IsNullOrWhiteSpace(trimmedName) || trimmedName.Length > 50)
        {
            await ShowErrorAsync("Nazwa kategorii nie może być pusta.");
            return;
        }

        var response = await Http.PutAsJsonAsync($"http://localhost:5226/api/Budget/categories/{editingCategoryId.Value}", trimmedName);
        if (!response.IsSuccessStatusCode)
        {
            await ShowErrorAsync("Nie udało się zapisać kategorii.");
            return;
        }

        await LoadCategories();
        editingCategoryId = null;
        editingCategoryName = string.Empty;
    }

    private async Task DeleteCategory(Category category)
    {
        if (IsProtectedCategory(category))
        {
            return;
        }

        var confirmMessage = "Czy na pewno chcesz usunąć tę kategorię?";

        try
        {
            var usage = await Http.GetFromJsonAsync<CategoryUsageResponse>($"http://localhost:5226/api/categories/{category.Id}/usage");
            var usageCount = usage?.Count ?? 0;

            if (usageCount > 0)
            {
                confirmMessage = $"Ta kategoria jest używana przez {usageCount} wydatków. Po usunięciu zostaną oznaczone jako 'Brak kategorii'. Czy chcesz kontynuować?";
            }
        }
        catch
        {
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", confirmMessage);
        if (!confirmed)
        {
            return;
        }

        var response = await Http.DeleteAsync($"api/budget/categories/{category.Id}");
        if (!response.IsSuccessStatusCode)
        {
            await ShowErrorAsync("Nie udało się usunąć kategorii.");
            return;
        }

        if (editingCategoryId == category.Id)
        {
            CancelEdit();
        }

        await LoadCategories();
    }

    private void GoToPreviousPage()
    {
        if (CurrentPage > 1)
        {
            currentPage = CurrentPage - 1;
        }
    }

    private void GoToNextPage()
    {
        if (CurrentPage < TotalPages)
        {
            currentPage = CurrentPage + 1;
        }
    }

    private void GoToPage(int pageNumber)
    {
        currentPage = Math.Clamp(pageNumber, 1, TotalPages);
    }

    private void OnCategorySearchChanged()
    {
        currentPage = 1;
    }

    private void ApplyCategorySearch()
    {
        currentPage = 1;
    }

    private string GetPageButtonClass(int pageNumber)
    {
        return pageNumber == CurrentPage
            ? "categories-page-button categories-page-button-active"
            : "categories-page-button";
    }

    private void EnsureCurrentPageInRange()
    {
        currentPage = Math.Clamp(currentPage, 1, TotalPages);
    }

    private async Task ShowErrorAsync(string message)
    {
        statusMessage = message;
        isStatusError = true;
        await InvokeAsync(StateHasChanged);
    }

    private void ClearStatus()
    {
        statusMessage = string.Empty;
        isStatusError = false;
    }

    private bool MatchesCategorySearch(Category category)
    {
        return string.IsNullOrWhiteSpace(categorySearchTerm)
            || category.Name.Contains(categorySearchTerm.Trim(), StringComparison.CurrentCultureIgnoreCase);
    }

    private static bool IsProtectedCategory(Category category)
    {
        return category.IsSystem
            || string.Equals(category.Name, "Brak kategorii", StringComparison.CurrentCultureIgnoreCase);
    }

    public async ValueTask DisposeAsync()
    {
        if (adaptivePageSizer is not null)
        {
            await adaptivePageSizer.DisposeAsync();
        }
    }

    public class Category
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public bool IsSystem { get; set; }
    }

    private sealed class CategoryUsageResponse
    {
        public int Count { get; set; }
    }
}
